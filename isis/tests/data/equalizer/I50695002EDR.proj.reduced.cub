Object = spiceinit
  IsisVersion       = "3.4.13.0 beta | 2016-03-15"
  ProgramVersion    = 2014-04-27
  ProgramPath       = /work/projects/isis/latest/m02282/isis/bin
  ExecutionDateTime = 2016-04-18T15:39:08
  HostName          = bacon.wr.usgs.gov
  UserName          = ihumphrey
  Description       = "Update SPICE data (kernels, pointing, and position) for
