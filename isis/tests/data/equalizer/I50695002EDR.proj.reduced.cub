                   it.cgi
    PORT         = 80
  End_Group
End_Object

Object = cam2map
  IsisVersion       = "3.4.12.6662 beta | 2016-03-15"
  ProgramVersion    = 2016-02-09
  ProgramPath       = /usgs/pkgs/isis3.4.12/isis/bin
  ExecutionDateTime = 2016-04-18T16:31:54
  HostName          = bacon.wr.usgs.gov
  UserName          = ihumphrey
  Description       = "Convert camera image to a map projection"

  Group = UserParameters
    FROM          = /home/ihumphrey/odyssey2/ingested/I50695002EDR.cub
    MAP           = map.map
    TO            = /home/ihumphrey/odyssey2/mapped/I50695002EDR.cub
    MATCHMAP      = YES
    PIXRES        = CAMERA
    DEFAULTRANGE  = MINIMIZE
    LONSEAM       = AUTO
    INTERP        = CUBICCONVOLUTION
    WARPALGORITHM = AUTOMATIC
  End_Group
End_Object

