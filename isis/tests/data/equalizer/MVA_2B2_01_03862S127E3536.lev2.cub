Object = footprintinit
  IsisVersion       = "3.4.1.0 alpha | 2012-05-21"
  ProgramVersion    = 2012-05-14
  ProgramPath       = /work/projects/isis/latest/m00919/isis/bin
  ExecutionDateTime = 2012-06-25T14:42:42
  HostName          = cn5.ib.astrohpc
  UserName          = lweller
  Description       = "Creates a lat/lon polygon and writes it to the image"

  Group = UserParameters
    FROM              = lev1/MVA_2B2_01_03862S127E3536.lev1.cub
    INCREASEPRECISION = true
    INCTYPE           = LINCSINC
    LINC              = 100
    SINC              = 100
    LIMBTEST          = ELLIPSOID
    TESTXY            = FALSE
    MAP               = $base/templates/maps/sinusoidal.map
  End_Group
End_Object

Object = jigsaw
  IsisVersion       = "3.4.1.0 alpha | 2012-05-21"
  ProgramVersion    = 2011-12-20
  ProgramPath       = /work/projects/isis/latest/m00919/isis/bin
  ExecutionDateTime = 2012-06-28T11:27:45
  HostName          = astrovm1.wr.usgs.gov
  UserName          = lweller
  Description       = "Improves camera pointing and a whole lot more!"

  Group = UserParameters
    FROMLIST             = updated.lis
    CNET                 = Alph_VIS_Img_SubReg_Edit.net
    ONET                 = JigOut_Alph_VIS_Img_SubReg_Edit.net
    OBSERVATIONS         = No
    RADIUS               = yes
    UPDATE               = yes
    METHOD               = SPARSE
    ERRORPROPAGATION     = no
    OUTLIER_REJECTION    = no
    REJECTION_MULTIPLIER = 3.0
    MODEL1               = NONE
    SIGMA0               = 1.0e-10
    MAXITS               = 10
    CKDEGREE             = 2
    SOLVEDEGREE          = 2
    CAMSOLVE             = angles
    TWIST                = yes
    SPSOLVE              = no
    POINT_RADIUS_SIGMA   = 500
    CAMERA_ANGLES_SIGMA  = 0.5
    FILE_PREFIX          = RadAngTwist_Edit
    BUNDLEOUT_TXT        = yes
    OUTPUT_CSV           = yes
    RESIDUALS_CSV        = yes
  End_Group
End_Object

Object = cam2map
  IsisVersion       = "3.4.1.0 alpha | 2012-05-21"
  ProgramVersion    = 2012-04-30
  ProgramPath       = /work/projects/isis/latest/m00919/isis/bin
  ExecutionDateTime = 2012-06-28T11:29:40
  HostName          = astrovm1.wr.usgs.gov
  UserName          = lweller
  Description       = "Convert camera image to a map projection"

  Group = UserParameters
    FROM          = Updated_Lev1/MVA_2B2_01_03862S127E3536.lev1.cub
    MAP           = equi_clon0.map
    TO            = Lev2/Controlled/MVA_2B2_01_03862S127E3536.lev2.cub
    MATCHMAP      = false
    PIXRES        = map
    DEFAULTRANGE  = MINIMIZE
    LONSEAM       = AUTO
    INTERP        = CUBICCONVOLUTION
    WARPALGORITHM = AUTOMATIC
  End_Group
End_Object

Object = crop
  IsisVersion       = "10.0.0  | 2026-05-11"
  AleVersion        = "1.1.3 | py313h5c29297_0"
  ProgramVersion    = 2015-01-15
  ProgramPath       = /Users/kewilliams/src/ISIS3/build-arm-debug/bin
  ExecutionDateTime = 2026-05-11T12:26:55
  HostName          = Unknown
  UserName          = kewilliams
  Description       = "Extracts a sub-area from a cube"

  Group = UserParameters
    FROM      = /Users/kewilliams/isistestdata/isis/src/base/apps/equalizer/t-
                sts/noHoldCalculateSparse/input/MVA_2B2_01_03862S127E3536.lev-
                2.cub
